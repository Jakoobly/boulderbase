rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isActiveMember(data) {
      return signedIn()
        && data.members[request.auth.uid].active == true;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.members[request.auth.uid].active == true;
    }

    function isGroupAdmin(data) {
      return signedIn()
        && data.members[request.auth.uid].active == true
        && (
          data.createdBy == request.auth.uid
          || data.members[request.auth.uid].role == "owner"
          || data.members[request.auth.uid].role == "admin"
        );
    }

    function isGroupCreator(data) {
      return signedIn() && data.createdBy == request.auth.uid;
    }

    function isGroupCreatorById(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.createdBy == request.auth.uid;
    }

    function createdByUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    function isJoiningGroupAsSelf() {
      return signedIn()
        && createdByUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid
        && request.resource.data.members[request.auth.uid].active == true
        && request.resource.data.members[request.auth.uid].role == "member";
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow create, update, delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid
        && request.resource.data.members[request.auth.uid].active == true
        && request.resource.data.members[request.auth.uid].role == "owner";
      allow update: if signedIn()
        && createdByUnchanged()
        && (
          isGroupCreator(resource.data)
          || isGroupAdmin(resource.data)
          || isJoiningGroupAsSelf()
          || isActiveMember(resource.data)
        );
      allow delete: if isGroupCreator(resource.data);

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string;
        allow update, delete: if isGroupAdmin(groupDoc(groupId).data);
      }
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || resource.data.participants[request.auth.uid] != null
          || (
            resource.data.groupId != null
            && isGroupMember(resource.data.groupId)
          )
        );
      allow delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || (
            resource.data.groupId != null
            && isGroupCreatorById(resource.data.groupId)
          )
        );
    }

    match /challenges/{challengeId} {
      allow read: if signedIn()
        && resource.data.groupId is string
        && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && isGroupAdmin(groupDoc(request.resource.data.groupId).data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.unit is string
        && request.resource.data.target is number
        && request.resource.data.target > 0;
      allow update: if signedIn()
        && resource.data.groupId is string
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && isGroupMember(resource.data.groupId);
      allow delete: if signedIn()
        && resource.data.groupId is string
        && isGroupAdmin(groupDoc(resource.data.groupId).data);
    }

    match /groupPolls/{pollId} {
      allow read: if signedIn()
        && resource.data.groupId is string
        && isGroupMember(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && isGroupAdmin(groupDoc(request.resource.data.groupId).data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.type in ["poll", "schedule"]
        && request.resource.data.options is list;
      allow update: if signedIn()
        && resource.data.groupId is string
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          isGroupAdmin(groupDoc(resource.data.groupId).data)
          || (
            isGroupMember(resource.data.groupId)
            && resource.data.status == "active"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votes", "updatedAtMillis"])
            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.votes[request.auth.uid].uid == request.auth.uid
          )
        );
      allow delete: if signedIn()
        && resource.data.groupId is string
        && isGroupAdmin(groupDoc(resource.data.groupId).data);
    }

    match /monthlyChallenges/{challengeId} {
      allow read: if signedIn();

      // Monatschallenges werden zentral/Admin-seitig angelegt, nicht durch normale Nutzer.
      allow create: if false;

      // Normale Nutzer dürfen nur ihren eigenen Beitrag zur bestehenden globalen Challenge ändern.
      allow update: if signedIn()
        && request.resource.data.title == resource.data.title
        && request.resource.data.target == resource.data.target
        && request.resource.data.unit == resource.data.unit
        && request.resource.data.status == resource.data.status
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participants", "totalProgress"])
        && request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.participants[request.auth.uid].uid == request.auth.uid
        && request.resource.data.participants[request.auth.uid].value is number
        && request.resource.data.participants[request.auth.uid].value >= 0
        && request.resource.data.totalProgress is number
        && request.resource.data.totalProgress >= resource.data.totalProgress;

      allow delete: if false;
    }

    match /directChats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in request.resource.data.members;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;
        allow update, delete: if false;
      }
    }

    match /friendCompetitions/{competitionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid in resource.data.members;
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }
  }
}
