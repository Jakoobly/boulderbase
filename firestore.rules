rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isGroupCreator(data) {
      return signedIn() && data.createdBy == request.auth.uid;
    }

    function isActiveMember(data) {
      return signedIn()
        && data.members[request.auth.uid].active == true;
    }

    function isGroupAdmin(data) {
      return signedIn()
        && data.members[request.auth.uid].active == true
        && (
          data.createdBy == request.auth.uid
          || data.members[request.auth.uid].role == "owner"
          || data.members[request.auth.uid].role == "admin"
        );
    }

    function createdByUnchanged() {
      return request.resource.data.createdBy == resource.data.createdBy;
    }

    function isJoiningGroupAsSelf() {
      return signedIn()
        && createdByUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid
        && request.resource.data.members[request.auth.uid].active == true
        && request.resource.data.members[request.auth.uid].role == "member";
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.members[request.auth.uid].active == true;
    }

    function isGroupCreatorById(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && groupDoc(groupId).data.createdBy == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;

      match /friends/{friendUid} {
        allow read: if isSelf(uid);

        // Nötig beim Annehmen/Entfernen, weil beide Friend-Dokumente geschrieben werden.
        allow create, update, delete: if signedIn()
          && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    match /friendRequests/{requestId} {
      // Bewusst etwas offener, weil die App vor dem Senden auch vorhandene/reverse Requests per getDoc prüft.
      // Sonst scheitert schon das Prüfen auf bestehende Anfragen.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.status == "pending";

      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid;

      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members[request.auth.uid].uid == request.auth.uid
        && request.resource.data.members[request.auth.uid].active == true
        && request.resource.data.members[request.auth.uid].role == "owner";

      allow update: if signedIn()
        && createdByUnchanged()
        && (
          // Ersteller darf Gruppe verwalten.
          isGroupCreator(resource.data)

          // Admins dürfen Gruppe/Rollen verwalten, aber nicht den Ersteller ändern.
          || isGroupAdmin(resource.data)

          // Neue Nutzer dürfen sich selbst als normales Mitglied eintragen.
          || isJoiningGroupAsSelf()

          // Aktive Mitglieder dürfen App-Updates schreiben, z.B. Stats/sessionCount.
          || isActiveMember(resource.data)
        );

      // Nur der Gruppenersteller darf die Gruppe löschen.
      allow delete: if isGroupCreator(resource.data);
    }

    match /sessions/{sessionId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || resource.data.participants[request.auth.uid] != null
          || (
            resource.data.groupId != null
            && isGroupMember(resource.data.groupId)
          )
        );

      // Wichtig fürs Gruppe-Löschen: der Gruppenersteller darf die zugehörigen Sessions löschen.
      allow delete: if signedIn()
        && (
          resource.data.createdBy == request.auth.uid
          || (
            resource.data.groupId != null
            && isGroupCreatorById(resource.data.groupId)
          )
        );
    }

    match /challenges/{challengeId} {
      // Challenges gehören immer zu einer Gruppe.
      // Lesen: nur aktive Gruppenmitglieder.
      allow read: if signedIn()
        && resource.data.groupId is string
        && isGroupMember(resource.data.groupId);

      // Erstellen: nur Admins/Owner/Ersteller der Gruppe.
      allow create: if signedIn()
        && request.resource.data.groupId is string
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
        && isGroupAdmin(groupDoc(request.resource.data.groupId).data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.unit is string
        && request.resource.data.target is number
        && request.resource.data.target > 0;

      // Fortschritt / Ergebnisse ändern: nur Admins/Owner/Ersteller der Gruppe.
      // groupId und createdBy dürfen dabei nicht verändert werden.
      allow update: if signedIn()
        && resource.data.groupId is string
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && isGroupAdmin(groupDoc(resource.data.groupId).data);

      // Löschen: nur Admins/Owner/Ersteller der Gruppe.
      allow delete: if signedIn()
        && resource.data.groupId is string
        && isGroupAdmin(groupDoc(resource.data.groupId).data);
    }
  }
}
