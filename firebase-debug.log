[debug] [2026-05-30T10:22:04.573Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/boulderbase-c1613/rulesets {"name":"projects/boulderbase-c1613/rulesets/3dc15944-c06d-40a1-a64d-676e95684b80","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isSelf(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function groupDoc(groupId) {\n      return get(/databases/$(database)/documents/groups/$(groupId));\n    }\n\n    function isActiveMember(data) {\n      return signedIn()\n        && data.members[request.auth.uid].active == true;\n    }\n\n    function isGroupMember(groupId) {\n      return signedIn()\n        && exists(/databases/$(database)/documents/groups/$(groupId))\n        && groupDoc(groupId).data.members[request.auth.uid].active == true;\n    }\n\n    function isGroupAdmin(data) {\n      return signedIn()\n        && data.members[request.auth.uid].active == true\n        && (\n          data.createdBy == request.auth.uid\n          || data.members[request.auth.uid].role == \"owner\"\n          || data.members[request.auth.uid].role == \"admin\"\n        );\n    }\n\n    function isGroupCreator(data) {\n      return signedIn() && data.createdBy == request.auth.uid;\n    }\n\n    function isGroupCreatorById(groupId) {\n      return signedIn()\n        && exists(/databases/$(database)/documents/groups/$(groupId))\n        && groupDoc(groupId).data.createdBy == request.auth.uid;\n    }\n\n    function createdByUnchanged() {\n      return request.resource.data.createdBy == resource.data.createdBy;\n    }\n\n    function isJoiningGroupAsSelf() {\n      return signedIn()\n        && createdByUnchanged()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"members\"])\n        && request.resource.data.members[request.auth.uid].uid == request.auth.uid\n        && request.resource.data.members[request.auth.uid].active == true\n        && request.resource.data.members[request.auth.uid].role == \"member\";\n    }\n\n    match /users/{uid} {\n      allow read: if signedIn();\n      allow create, update: if isSelf(uid);\n      allow delete: if false;\n\n      match /friends/{friendUid} {\n        allow read: if isSelf(uid);\n        allow create, update, delete: if signedIn()\n          && (request.auth.uid == uid || request.auth.uid == friendUid);\n      }\n    }\n\n    match /friendRequests/{requestId} {\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.fromUid == request.auth.uid\n        && request.resource.data.toUid is string\n        && request.resource.data.status == \"pending\";\n      allow update: if signedIn()\n        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)\n        && request.resource.data.fromUid == resource.data.fromUid\n        && request.resource.data.toUid == resource.data.toUid;\n      allow delete: if signedIn()\n        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);\n    }\n\n    match /groups/{groupId} {\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.members[request.auth.uid].uid == request.auth.uid\n        && request.resource.data.members[request.auth.uid].active == true\n        && request.resource.data.members[request.auth.uid].role == \"owner\";\n      allow update: if signedIn()\n        && createdByUnchanged()\n        && (\n          isGroupCreator(resource.data)\n          || isGroupAdmin(resource.data)\n          || isJoiningGroupAsSelf()\n          || isActiveMember(resource.data)\n        );\n      allow delete: if isGroupCreator(resource.data);\n\n      match /messages/{messageId} {\n        allow read: if isGroupMember(groupId);\n        allow create: if isGroupMember(groupId)\n          && request.resource.data.senderId == request.auth.uid\n          && request.resource.data.text is string;\n        allow update, delete: if isGroupAdmin(groupDoc(groupId).data);\n      }\n    }\n\n    match /sessions/{sessionId} {\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.createdBy == request.auth.uid;\n      allow update: if signedIn()\n        && (\n          resource.data.createdBy == request.auth.uid\n          || resource.data.participants[request.auth.uid] != null\n          || (\n            resource.data.groupId != null\n            && isGroupMember(resource.data.groupId)\n          )\n        );\n      allow delete: if signedIn()\n        && (\n          resource.data.createdBy == request.auth.uid\n          || (\n            resource.data.groupId != null\n            && isGroupCreatorById(resource.data.groupId)\n          )\n        );\n    }\n\n    match /challenges/{challengeId} {\n      allow read: if signedIn()\n        && resource.data.groupId is string\n        && isGroupMember(resource.data.groupId);\n      allow create: if signedIn()\n        && request.resource.data.groupId is string\n        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))\n        && isGroupAdmin(groupDoc(request.resource.data.groupId).data)\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.title is string\n        && request.resource.data.unit is string\n        && request.resource.data.target is number\n        && request.resource.data.target > 0;\n      allow update: if signedIn()\n        && resource.data.groupId is string\n        && request.resource.data.groupId == resource.data.groupId\n        && request.resource.data.createdBy == resource.data.createdBy\n        && isGroupMember(resource.data.groupId);\n      allow delete: if signedIn()\n        && resource.data.groupId is string\n        && isGroupAdmin(groupDoc(resource.data.groupId).data);\n    }\n\n    match /groupPolls/{pollId} {\n      allow read: if signedIn()\n        && resource.data.groupId is string\n        && isGroupMember(resource.data.groupId);\n      allow create: if signedIn()\n        && request.resource.data.groupId is string\n        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))\n        && isGroupAdmin(groupDoc(request.resource.data.groupId).data)\n        && request.resource.data.createdBy == request.auth.uid\n        && request.resource.data.title is string\n        && request.resource.data.type in [\"poll\", \"schedule\"]\n        && request.resource.data.options is list;\n      allow update: if signedIn()\n        && resource.data.groupId is string\n        && request.resource.data.groupId == resource.data.groupId\n        && request.resource.data.createdBy == resource.data.createdBy\n        && (\n          isGroupAdmin(groupDoc(resource.data.groupId).data)\n          || (\n            isGroupMember(resource.data.groupId)\n            && resource.data.status == \"active\"\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"votes\", \"updatedAtMillis\"])\n            && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid])\n            && request.resource.data.votes[request.auth.uid].uid == request.auth.uid\n          )\n        );\n      allow delete: if signedIn()\n        && resource.data.groupId is string\n        && isGroupAdmin(groupDoc(resource.data.groupId).data);\n    }\n\n    match /monthlyChallenges/{challengeId} {\n      allow read: if signedIn();\n\n      // Monatschallenges werden zentral/Admin-seitig angelegt, nicht durch normale Nutzer.\n      allow create: if false;\n\n      // Normale Nutzer dürfen nur ihren eigenen Beitrag zur bestehenden globalen Challenge ändern.\n      allow update: if signedIn()\n        && request.resource.data.title == resource.data.title\n        && request.resource.data.target == resource.data.target\n        && request.resource.data.unit == resource.data.unit\n        && request.resource.data.status == resource.data.status\n        && request.resource.data.visibility == resource.data.visibility\n        && request.resource.data.createdBy == resource.data.createdBy\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\"participants\", \"totalProgress\"])\n        && request.resource.data.participants.diff(resource.data.participants).affectedKeys().hasOnly([request.auth.uid])\n        && request.resource.data.participants[request.auth.uid].uid == request.auth.uid\n        && request.resource.data.participants[request.auth.uid].value is number\n        && request.resource.data.participants[request.auth.uid].value >= 0\n        && request.resource.data.totalProgress is number\n        && request.resource.data.totalProgress >= resource.data.totalProgress;\n\n      allow delete: if false;\n    }\n\n    match /directChats/{chatId} {\n      allow read: if signedIn() && request.auth.uid in resource.data.members;\n      allow create, update: if signedIn()\n        && request.auth.uid in request.resource.data.members;\n      allow delete: if false;\n\n      match /messages/{messageId} {\n        allow read: if signedIn()\n          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;\n        allow create: if signedIn()\n          && request.resource.data.senderId == request.auth.uid\n          && request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.members;\n        allow update, delete: if false;\n      }\n    }\n\n    match /friendCompetitions/{competitionId} {\n      allow read: if signedIn() && request.auth.uid in resource.data.members;\n      allow create: if signedIn()\n        && request.auth.uid in request.resource.data.members\n        && request.resource.data.creatorId == request.auth.uid;\n      allow update: if signedIn() && request.auth.uid in resource.data.members;\n      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-30T10:22:03.827983Z","metadata":{"services":["cloud.firestore"]}}
